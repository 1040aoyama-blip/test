---
import { localizePath, t, type Lang } from '../i18n';
import type { CatalogItem } from '../data/catalog';

interface Props {
  lang: Lang;
  prefectureId: string;
  item: CatalogItem;
}

const { lang, prefectureId, item } = Astro.props;
const { info } = item;
const mapsHref = `https://www.google.com/maps/search/?${new URLSearchParams({ api: '1', query: item.mapQuery })}`;
---

<article class:list={['dish', { brief: !info }]} id={item.anchor}>
  <header>
    <h3>{item.name}</h3>
    {lang !== 'ja' && <p class="ja" lang="ja">{item.ja}</p>}
  </header>

  {
    info && (
      <>
        <p class="summary">{info.summary}</p>
        {(info.price || info.area) && (
          <dl class="facts">
            {info.price && (
              <div>
                <dt>{t(lang, 'priceRange')}</dt>
                <dd>{info.price}</dd>
              </div>
            )}
            {info.area && (
              <div>
                <dt>{t(lang, 'area')}</dt>
                <dd>{info.area}</dd>
              </div>
            )}
          </dl>
        )}
        {info.tip && (
          <p class="tip">
            <span class="label">{t(lang, 'tip')}</span>
            {info.tip}
          </p>
        )}
      </>
    )
  }

  <footer class="actions">
    <a class="maps" href={mapsHref} target="_blank" rel="noopener">{t(lang, 'searchMaps')}</a>
    {
      item.gourmet && (
        <a class="more" href={localizePath(lang, `/${prefectureId}/${item.gourmet.id}/`)}>
          {t(lang, 'readMore')} →
        </a>
      )
    }
  </footer>
</article>

<style>
  .dish {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 5rem;
  }
  .dish:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .brief {
    padding-block: 0.9rem;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .ja {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .summary {
    margin: 0;
    line-height: 1.7;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    font-size: 0.9rem;
  }
  .facts div {
    display: flex;
    gap: 0.4rem;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 700;
  }
  .tip {
    margin: 0;
    padding: 0.55rem 0.8rem;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .label {
    margin-right: 0.5rem;
    color: var(--accent);
    font-weight: 700;
  }
  .actions {
    margin-top: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .actions a {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .maps {
    border: 1px solid var(--border);
    color: var(--text);
  }
  .maps:hover {
    border-color: var(--accent);
  }
  .more {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
