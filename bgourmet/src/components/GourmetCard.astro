---
import { localizePath, type Lang } from '../i18n/ui';
import type { Gourmet } from '../data/gourmet';
import { getPrefecture } from '../data/prefectures';

interface Props {
  lang: Lang;
  gourmet: Gourmet;
  showPrefecture?: boolean;
}

const { lang, gourmet, showPrefecture = false } = Astro.props;
const pref = getPrefecture(gourmet.prefecture);
---

<a class="card" href={localizePath(lang, `/${pref.id}/${gourmet.id}/`)}>
  <span class="emoji" aria-hidden="true">{gourmet.emoji}</span>
  <span class="body">
    {showPrefecture && <span class="pref">{pref.name[lang]}</span>}
    <strong>{gourmet.name[lang]}</strong>
    <span class="summary">{gourmet.summary[lang]}</span>
  </span>
</a>

<style>
  .card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .emoji {
    font-size: 2.2rem;
    line-height: 1;
  }
  .body {
    display: grid;
    gap: 0.2rem;
  }
  .pref {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }
  strong {
    font-size: 1.1rem;
  }
  .summary {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
