---
/**
 * Klook の「Dynamic Widget」（サムネ付きの体験の一覧）。
 * Klook のアフィリエイト管理画面の Widget で作ったコードを、値を変えずにそのまま出す。
 * adid・destId は src/data/affiliates.ts の klookWidgets（管理画面のコードにある data-adid・data-dest_id）
 */
interface Props {
  adid: string;
  destId: string;
}

const { adid, destId } = Astro.props;
---

<div class="klook-widget">
  <ins
    class="klk-aff-widget"
    data-adid={adid}
    data-lang=""
    data-currency=""
    data-cardH="126"
    data-padding="92"
    data-lgH="470"
    data-edgeValue="655"
    data-dest_id={destId}
    data-tid="-1"
    data-amount="6"
    data-prod="dynamic_widget"><a href="//www.klook.com/">Klook.com</a></ins
  >
</div>
<script is:inline>
  (function (d, sc, u) {
    var s = d.createElement(sc),
      p = d.getElementsByTagName(sc)[0];
    s.type = 'text/javascript';
    s.async = true;
    s.src = u;
    p.parentNode.insertBefore(s, p);
  })(document, 'script', 'https://affiliate.klook.com/widget/fetch-iframe-init.js');
</script>

<style is:global>
  .klook-widget {
    margin-bottom: 1rem;
    max-width: 100%;
    overflow: hidden;
  }
</style>
