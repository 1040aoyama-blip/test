---
import BaseLayout from '../layouts/BaseLayout.astro';
import DishEntry from '../components/DishEntry.astro';
import { localizePath, t, type Lang } from '../i18n';
import { getIntro, getPrefecture, regions } from '../data/prefectures';
import { getCatalog } from '../data/catalog';
import { getPrefectureAffiliates } from '../data/affiliates';
import AffiliateBox from '../components/AffiliateBox.astro';
import KlookWidget from '../components/KlookWidget.astro';
import KlookScript from '../components/KlookScript.astro';

interface Props {
  lang: Lang;
  prefectureId: string;
}

const { lang, prefectureId } = Astro.props;
const pref = getPrefecture(prefectureId);
const region = regions.find((r) => r.id === pref.region)!;
const groups = getCatalog(lang, pref.id);
const dishCount = groups.reduce((sum, g) => sum + g.items.length, 0);
const title = t(lang, 'prefectureTitle', { pref: pref.name[lang] });
const intro = getIntro(lang, pref.id);
const affiliates = getPrefectureAffiliates(lang, pref.id, pref.name[lang]);
---

<BaseLayout lang={lang} path={`/${pref.id}/`} title={title} description={intro}>
  <nav class="crumbs">
    <a href={localizePath(lang, '/')}>{t(lang, 'siteName')}</a> › {region.name[lang]}
  </nav>
  <h1>{pref.name[lang]}</h1>
  {intro && <p class="intro">{intro}</p>}
  {dishCount > 0 && <p class="count">{t(lang, 'dishCount', { n: dishCount })}</p>}

  {
    groups.length > 1 && (
      <nav class="jump" aria-label={t(lang, 'jumpTo')}>
        {groups.map((group) => (
          <a href={`#${group.category}`}>
            {t(lang, `category_${group.category}`)}
            <span class="n">{group.items.length}</span>
          </a>
        ))}
      </nav>
    )
  }

  {
    groups.map((group) => (
      <section class="group" id={group.category}>
        <h2>
          {t(lang, `category_${group.category}`)}
          <span class="n">{group.items.length}</span>
        </h2>
        <div class="dishes">
          {group.items.map((item) => (
            <DishEntry lang={lang} item={item} />
          ))}
        </div>
      </section>
    ))
  }

  {
    affiliates.length > 0 && (
      <section class="experiences">
        <h2>{t(lang, 'planTripTitle', { pref: pref.name[lang] })}</h2>
        {affiliates.map((block) => (
          <div class="aff-block">
            <h3>{t(lang, `affiliate_${block.kind}`)}</h3>
            {block.widget && <KlookWidget {...block.widget} />}
            {block.links.length > 0 && <AffiliateBox lang={lang} links={block.links} />}
          </div>
        ))}
        {affiliates.some((b) => b.widget) && <KlookScript />}
      </section>
    )
  }

  <p class="back"><a href={localizePath(lang, '/')}>← {t(lang, 'backToTop')}</a></p>
</BaseLayout>

<style>
  .experiences {
    margin-top: 2.5rem;
  }
  .experiences h2 {
    font-size: 1.3rem;
  }
  .aff-block {
    margin-top: 1.5rem;
  }
  .aff-block h3 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }
  .crumbs {
    color: var(--muted);
    font-size: 0.85rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .intro {
    max-width: 46rem;
    margin: 0.5rem 0 0.75rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .count {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--accent);
  }
  .group {
    margin-top: 2rem;
    scroll-margin-top: 4.5rem;
  }
  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent-soft);
  }
  .n {
    padding: 0 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .dishes {
    display: grid;
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
