---
import BaseLayout from '../layouts/BaseLayout.astro';
import DishEntry from '../components/DishEntry.astro';
import GourmetCard from '../components/GourmetCard.astro';
import { localizePath, t, type Lang } from '../i18n';
import { getPrefecture, regions } from '../data/prefectures';
import { getGourmets } from '../data/gourmet';
import { getCatalog } from '../data/catalog';

interface Props {
  lang: Lang;
  prefectureId: string;
}

const { lang, prefectureId } = Astro.props;
const pref = getPrefecture(prefectureId);
const region = regions.find((r) => r.id === pref.region)!;
const groups = await getCatalog(lang, pref.id);
const dishCount = groups.reduce((sum, g) => sum + g.items.length, 0);
// 一覧にその言語の料理名がまだない場合は、記事だけを並べる
const articles = (await getGourmets(lang)).filter((g) => g.meta.prefecture === pref.id);
const title = t(lang, 'prefectureTitle', { pref: pref.name[lang] });
---

<BaseLayout lang={lang} path={`/${pref.id}/`} title={title}>
  <nav class="crumbs">
    <a href={localizePath(lang, '/')}>{t(lang, 'siteName')}</a> › {region.name[lang]}
  </nav>
  <h1>{title}</h1>
  {dishCount > 0 && <p class="count">{t(lang, 'dishCount', { n: dishCount })}</p>}

  {
    groups.length > 1 && (
      <nav class="jump" aria-label={t(lang, 'jumpTo')}>
        {groups.map((group) => (
          <a href={`#${group.category}`}>
            {t(lang, `category_${group.category}`)}
            <span class="n">{group.items.length}</span>
          </a>
        ))}
      </nav>
    )
  }

  {
    groups.length > 0 ? (
      groups.map((group) => (
        <section class="group" id={group.category}>
          <h2>
            {t(lang, `category_${group.category}`)}
            <span class="n">{group.items.length}</span>
          </h2>
          <div class="dishes">
            {group.items.map((item) => (
              <DishEntry lang={lang} prefectureId={pref.id} item={item} />
            ))}
          </div>
        </section>
      ))
    ) : articles.length > 0 ? (
      <div class="cards">
        {articles.map((g) => (
          <GourmetCard lang={lang} gourmet={g} />
        ))}
      </div>
    ) : (
      <p class="soon">
        <strong>{t(lang, 'comingSoon')}</strong>
        <br />
        {t(lang, 'comingSoonBody')}
      </p>
    )
  }

  <p class="back"><a href={localizePath(lang, '/')}>← {t(lang, 'backToTop')}</a></p>
</BaseLayout>

<style>
  .crumbs {
    color: var(--muted);
    font-size: 0.85rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .count {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--accent);
  }
  .group {
    margin-top: 2rem;
    scroll-margin-top: 4.5rem;
  }
  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent-soft);
  }
  .n {
    padding: 0 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .dishes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 0.75rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .soon {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
