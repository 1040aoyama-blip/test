---
import BaseLayout from '../layouts/BaseLayout.astro';
import GourmetCard from '../components/GourmetCard.astro';
import { localizePath, t, type Lang } from '../i18n';
import { getPrefecture, regions } from '../data/prefectures';
import { getGourmets } from '../data/gourmet';
import { getCatalog } from '../data/catalog';

interface Props {
  lang: Lang;
  prefectureId: string;
}

const { lang, prefectureId } = Astro.props;
const pref = getPrefecture(prefectureId);
const region = regions.find((r) => r.id === pref.region)!;
const groups = await getCatalog(lang, pref.id);
const dishCount = groups.reduce((sum, g) => sum + g.items.length, 0);
// 一覧にその言語の料理名がまだない場合は、記事だけを並べる
const articles = (await getGourmets(lang)).filter((g) => g.meta.prefecture === pref.id);
const title = t(lang, 'prefectureTitle', { pref: pref.name[lang] });
---

<BaseLayout lang={lang} path={`/${pref.id}/`} title={title}>
  <nav class="crumbs">
    <a href={localizePath(lang, '/')}>{t(lang, 'siteName')}</a> › {region.name[lang]}
  </nav>
  <h1>{title}</h1>
  {dishCount > 0 && <p class="count">{t(lang, 'dishCount', { n: dishCount })}</p>}

  {
    groups.length > 0 ? (
      groups.map((group) => {
        const withArticle = group.items.filter((item) => item.gourmet);
        const withoutArticle = group.items.filter((item) => !item.gourmet);
        return (
          <section class="group">
            <h2>
              {t(lang, `category_${group.category}`)}
              <span class="n">{group.items.length}</span>
            </h2>
            {withArticle.length > 0 && (
              <div class="grid">
                {withArticle.map((item) => (
                  <GourmetCard lang={lang} gourmet={item.gourmet!} />
                ))}
              </div>
            )}
            {withoutArticle.length > 0 && (
              <ul class="dishes">
                {withoutArticle.map((item) => (
                  <li>
                    {item.name}
                    <span class="pending">{t(lang, 'articlePreparing')}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    ) : articles.length > 0 ? (
      <div class="grid">
        {articles.map((g) => (
          <GourmetCard lang={lang} gourmet={g} />
        ))}
      </div>
    ) : (
      <p class="soon">
        <strong>{t(lang, 'comingSoon')}</strong>
        <br />
        {t(lang, 'comingSoonBody')}
      </p>
    )
  }

  <p class="back"><a href={localizePath(lang, '/')}>← {t(lang, 'backToTop')}</a></p>
</BaseLayout>

<style>
  .crumbs {
    color: var(--muted);
    font-size: 0.85rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .count {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
  .group {
    margin-top: 2rem;
  }
  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent-soft);
  }
  .n {
    padding: 0 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .dishes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dishes li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .pending {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .soon {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
